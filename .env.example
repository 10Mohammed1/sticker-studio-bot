# Get this token from @BotFather. Never publish it or commit it to GitHub.
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Your numeric Telegram user ID(s), comma-separated. Send /id to the bot to learn yours.
# Example: ADMIN_IDS=123456789
ADMIN_IDS=

# Optional: Telegram usernames (without @) that get admin rights.
# Each username is bound once to the first numeric ID that uses it.
# Example: ADMIN_USERNAMES=M_O_EG
ADMIN_USERNAMES=

# Persistent storage. DATA_DIR is shared by the database and temporary work files.
# Leave DATABASE_PATH and TEMP_DIR empty to keep both inside DATA_DIR.
DATA_DIR=data
DATABASE_PATH=
TEMP_DIR=

# Telegram Bot API standard getFile download limit is 20 MB.
MAX_DOWNLOAD_MB=20
MAX_EXPANDED_MB=100
MAX_ARCHIVE_ITEMS=40
MAX_PDF_PAGES=12
MAX_PROCESSING_SECONDS=150

# Try local AI background removal when the optional rembg package is installed.
ENABLE_BG_REMOVAL=0

# FFmpeg is required for GIF/video/audio/motion conversions.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Automatic permanent packs on every conversion (one static + one animated).
# 0 = no pack is created automatically; stickers are added only to a pack you
#     create yourself with /newpack (recommended if you want manual control).
# 1 = every user gets a permanent pair created on the first converted file.
# The per-user toggle in ⚙️ إعدادات الحزم can still pause it at runtime.
AUTO_PACK=0

# Periodic verified SQLite backups inside the persistent data volume.
# On Railway DATA_DIR=/app/data so backups survive redeploys with the Volume.
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=7

# Per-user abuse protection and worker limits.
USER_COOLDOWN_SECONDS=2
MAX_CONCURRENT_JOBS=1
# How many queued/running jobs one user may have at the same time.
MAX_JOBS_PER_USER=2

# Start in maintenance mode (admins can still use the bot).
MAINTENANCE_MODE=false

# Prefer IPv4 when connecting to Telegram. Set to 0 only if your host requires IPv6.
FORCE_IPV4=1

# Optional proxy for Telegram API traffic, e.g. socks5://127.0.0.1:1080.
# Useful when the host blocks or throttles Telegram file uploads.
TELEGRAM_PROXY=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Backward-compatible alias for DATA_DIR (old conversion-engine deployments).
# WORK_DIR=./data

# Sticker Studio 4.0 optional feature storage lives under DATA_DIR/feature_sessions.
# Keep one Railway replica when using SQLite + Telegram long polling.
