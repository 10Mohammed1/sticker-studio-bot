# ============================================================
#  Sticker Studio 4.1.1 — الإعدادات المطلوبة (متغيّران فقط)
# ============================================================

# 1) توكن البوت من @BotFather. لا تشاركه ولا ترفعه إلى GitHub.
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# 2) رقم حسابك في تيليجرام (مفصول بفواصل إن أردت أكثر من مشرف).
#    أرسل /i للبوت بعد التشغيل لتعرف رقمك، أو استخدم @userinfobot.
ADMIN_IDS=


# ============================================================
#  ما بعد ذلك اختياري تمامًا — القيم الافتراضية مناسبة للتشغيل
# ============================================================

# مكان قاعدة البيانات والملفات المؤقتة (Docker يضبطه إلى /app/data تلقائيًا).
# DATA_DIR=data
# DATABASE_PATH=
# TEMP_DIR=

# 0 = لا تُنشأ حزمة إلا بأمر /n (الافتراضي)
# 1 = حزمة ثابتة ومتحركة تلقائيًا لكل مستخدم من أول ملف
# AUTO_PACK=0

# نسخ احتياطي دوري مفحوص داخل DATA_DIR/backups.
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=7

# FFmpeg مثبّت داخل صورة Docker. للتشغيل المحلي اضبط المسار إن لم يكن في PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# حدود المعالجة
# MAX_DOWNLOAD_MB=20
# MAX_EXPANDED_MB=100
# MAX_ARCHIVE_ITEMS=40
# MAX_PDF_PAGES=12
# MAX_PROCESSING_SECONDS=150
# USER_COOLDOWN_SECONDS=2
# MAX_CONCURRENT_JOBS=2

# إزالة الخلفية بالذكاء الاصطناعي (اختياري ويحتاج حزمة rembg).
# ENABLE_BG_REMOVAL=0

# السجلات
# LOG_LEVEL=INFO
